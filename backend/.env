APP_NAME=VMusic API
APP_VERSION=1.0.0
DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./vmusic.db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=vmusic-dev-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

AUDIUS_API_BASE=https://discoveryprovider.audius.co/v1
AUDIUS_APP_NAME=VMusic
AUDIUS_CACHE_TTL_SECONDS=300

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000"]
